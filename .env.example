# Copy this to .env for local testing with `netlify dev`. NEVER commit your real key.
# On Netlify, set this under Site settings -> Environment variables instead.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Supabase — Project Settings -> API in the Supabase dashboard.
# Safe to expose in the browser bundle: the anon key only works within your RLS policies.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe — Developers -> API keys in the Stripe dashboard.
# For LOCAL TESTING: use a SANDBOX secret key (Stripe dashboard -> account
# picker -> Sandboxes -> pick/create one -> Developers -> API keys there).
# For the real Netlify deployment: the real live secret key (sk_live_...).
# Never expose this one to the browser bundle -- server-side (Netlify function) only.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret from the webhook endpoint you register in Stripe ->
# Developers -> Webhooks -- a DIFFERENT one for the sandbox's webhook endpoint
# vs. the live one. Needed once the webhook handler (Phase 5) exists.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Only needed locally, to test against sandbox Price IDs instead of the real
# live ones hardcoded as defaults in create-checkout-session.mjs. Leave unset
# on the real Netlify deployment -- the live defaults apply automatically.
PRICE_STANDARD_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
PRICE_STANDARD_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Service role ("secret") key -- Project Settings -> API in Supabase.
# NEVER the anon key. Needed to write auth.users.app_metadata.plan, which
# regular users can't write to themselves. Same key synthesize-memory.mjs uses.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Used to build Stripe Checkout success/cancel redirect URLs.
PUBLIC_SITE_URL=https://frontline-coach.com

# Read-aloud voice in Practice (netlify/functions/tts.mjs -> OpenAI gpt-4o-mini-tts).
# OPTIONAL. Without it the function returns 501 and the app quietly falls back to
# the browser's built-in voice, which still works but sounds synthetic.
# Set a hard spend limit on this key at platform.openai.com.
OPENAI_API_KEY
